{
  "$meta": {
    "name": "r352 design tokens",
    "source": ".brand/design-system.md",
    "version": "1.1",
    "verifiedAgainstCode": "2026-07-12",
    "note": "Machine-readable mirror of the design system. When this file and the code disagree, the code wins - fix this file."
  },
  "color": {
    "surface": {
      "background": "#151515",
      "backgroundDark": "#0A0A0A",
      "baseDeep": "#080808",
      "deepestFills": ["#050505", "#080808", "#111111"],
      "cardHover": "#0f0f0f",
      "graphiteBand": "#363636",
      "muted": "#1a1a1a",
      "border": "#262626"
    },
    "accent": {
      "lime": "#D4FF00",
      "limeLogo": "#DAFF45",
      "limeMascotVisor": "#c8f13a",
      "clay": "#D97757",
      "clayShader": "#D97657"
    },
    "text": {
      "foreground": "#f5f5f5",
      "mutedForeground": "#888888",
      "neutral300": "#D4D4D4",
      "neutral400": "#A3A3A3",
      "neutral500": "#737373",
      "white": "#FFFFFF"
    },
    "light": {
      "masterBackground": "#F1F6FA"
    },
    "hairline": {
      "default": "rgba(255,255,255,0.10)",
      "emphasis": "rgba(255,255,255,0.15)",
      "quiet": "rgba(255,255,255,0.05)"
    },
    "$rules": {
      "limeScopes": "UI/interactive/typographic = lime; logo artwork = limeLogo ONLY; limeMascotVisor is baked into the 3D render and must never become a CSS token",
      "noThirdLimeInUI": true
    }
  },
  "typography": {
    "display": {
      "family": "Tanker",
      "weight": 400,
      "transform": "uppercase",
      "selfHosted": "public/fonts/Tanker-Regular.woff2"
    },
    "body": {
      "families": ["BW Haas Head", "Plus Jakarta Sans"],
      "weightCap": 500
    },
    "hero": { "size": "clamp(2.75rem, 5.8vw, 7.25rem)" },
    "kicker": {
      "size": "10-11px",
      "transform": "uppercase",
      "tracking": "0.2em-0.3em",
      "color": "#D4FF00"
    },
    "numerals": "tabular-nums"
  },
  "motion": {
    "easing": {
      "signatureDecel": [0.22, 1, 0.36, 1],
      "sweepEase": [0.76, 0, 0.24, 1],
      "ultraDecel": [0.16, 1, 0.3, 1],
      "legacyThemeSweep": [0.55, 0, 0.35, 1]
    },
    "duration": {
      "revealsS": [0.55, 0.8],
      "routeSweepMs": 700,
      "themeSweepInMs": 700,
      "themeSweepTotalMs": 1500
    },
    "stagger": [0.05, 0.06],
    "spring": { "titleTilt": { "stiffness": 55, "damping": 14 } },
    "$rules": {
      "doNotInventAFifthCurve": true,
      "reducedMotion": "every canvas renders one still frame; variants collapse to fades"
    }
  },
  "layout": {
    "containerMax": "1800px",
    "gutters": { "base": "px-8", "md": "px-12" },
    "radius": "0rem",
    "bands": ["#151515", "#363636", "#080808"],
    "canvasPattern": "section.isolate > canvas.-z-10, overflow-hidden"
  },
  "webgl": {
    "shaderPalette": {
      "lime": [0.831, 1.0, 0.0],
      "clay": [0.851, 0.463, 0.341],
      "base": [0.012, 0.012, 0.012]
    },
    "dprCaps": { "webglGallery": 2.0, "homeHero": 1.75, "backdrops": 1.5 },
    "uniforms": ["u_res", "u_time", "u_mouse", "u_mdown", "u_bass", "u_mid", "u_high", "u_kick", "u_energy", "u_progress", "u_live"],
    "silentFallback": { "bass": 0.22, "mid": 0.22, "high": 0.18, "kick": 0 },
    "$rules": { "silenceEqualsStillness": true }
  },
  "voice": {
    "numberCanon": ["300+ clubs", "250+ locations", "3× faster approvals", "10k+ assets/year", "5+ yrs avg partnership", "80%+ briefs first-round"],
    "$rules": {
      "noLongDashes": "every dash is \"-\", EN and PL alike",
      "multiplySign": "3× uses U+00D7, never the letter x",
      "lowercaseBrands": ["r352", "r3loop", "wegobold"]
    }
  }
}
