{
  "ci": {
    "collect": {
      "url": [
        "https://www.r352.com/",
        "https://www.r352.com/services",
        "https://www.r352.com/process",
        "https://www.r352.com/work",
        "https://www.r352.com/work/sonova"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
